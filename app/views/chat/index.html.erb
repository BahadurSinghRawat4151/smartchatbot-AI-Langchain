<% content_for :title, "SmartChatBot - AI Shopping Assistant" %>

<div
  class="chat-site-shell"
>
  <main class="chat-site-hero">
    <section class="chat-site-copy">
      <p class="chat-site-eyebrow">Next-Generation AI Shopping Assistant</p>
      <h1>Experience seamless shopping with conversational AI.</h1>
      <p class="chat-site-lead">
        Control your entire shopping journey through simple, natural prompts. From discovering products to tracking your order, our advanced AI integration makes everything effortless.
      </p>

      <div class="chat-site-actions">
        <button
          type="button"
          class="chat-site-primary"
          data-action="chat-widget#open"
        >
          Start Chatting
        </button>
        <%# <p class="chat-site-note">The assistant is always available at the bottom-right of your screen.</p> %>
      </div>

      <div class="chat-site-metrics">
        <article>
          <strong>🛍️ Easy Navigation</strong>
          <span>Find products and navigate categories just by asking.</span>
        </article>
        <article>
          <strong>🛒 Instant Checkout</strong>
          <span>Add items to your cart and proceed to checkout via simple prompts.</span>
        </article>
        <article>
          <strong>📦 Product Details</strong>
          <span>Ask about specifications, stock availability, and variations.</span>
        </article>
        <article>
          <strong>🚚 Order & Policies</strong>
          <span>Check your order status and return policies instantly.(Comming Soon)</span>
        </article>
      </div>
    </section>

    <section class="chat-site-preview" aria-hidden="true">
      <div class="chat-preview-window">
        <div class="chat-preview-topbar">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="chat-preview-bubbles">
          <div class="chat-preview-bubble user">
            Show me the latest running shoes and add the blue ones to my cart.
          </div>
          <div class="chat-preview-bubble assistant">
            I found 3 great options! The Blue Sprint Pros have been added to your cart. Would you like to checkout now?
          </div>
          <div class="chat-preview-bubble user">
            Yes, and what's the return policy?
          </div>
          <div class="chat-preview-bubble assistant">
            You have a 30-day hassle-free return window. Sending you to the secure checkout page now!
          </div>
        </div>
      </div>
    </section>
  </main>

  
</div>
