<% content_for :title, "Change password | SmartChatBot" %>

<main class="auth-shell">
  <section class="auth-panel auth-panel-narrow">
    <div class="auth-card">
      <p class="auth-eyebrow">Password help</p>
      <h2>Choose a new password</h2>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="auth-field">
          <%= f.label :password, "New password" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "#{@minimum_password_length || 6}+ characters" %>
        </div>

        <div class="auth-field">
          <%= f.label :password_confirmation, "Confirm new password" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>

        <%= f.submit "Change password", class: "auth-submit" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </section>
</main>
