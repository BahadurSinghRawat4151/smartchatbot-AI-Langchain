<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Smartchatbot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Smartchatbot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <div
       
        data-controller="chat-widget"
        
        data-chat-widget-history-value="<%= @messages&.to_json || '[]' %>"
        data-chat-widget-endpoint-value="/chat/message"
      >
        <header class="app-topbar">
          <%= link_to "SmartChatBot", root_path, class: "app-brand" %>
          <nav class="app-nav" aria-label="Main navigation">
            <%= link_to "Products", products_path %>
            <%= link_to "Cart", cart_path %>
            <%= link_to "Account", edit_user_registration_path %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "app-nav-button" %>
          </nav>
        </header>

        <%= render "shared/flash" %>
        <%= yield %>

        <button
          type="button"
          class="chat-launcher"
          aria-label="Open chatbot"
          data-action="chat-widget#toggle"
          data-chat-widget-target="launcher"
        >
          <span class="chat-launcher-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3C6.925 3 3 6.658 3 11.19c0 2.353 1.07 4.45 2.893 5.893V21l3.634-2.007c.484.071.978.107 1.473.107 5.075 0 9-3.659 9-8.19S17.075 3 12 3Zm-4.25 9.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Zm4.25 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Zm4.25 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z"/>
            </svg>
          </span>
          <span class="chat-launcher-text">
            <strong>Chat with us</strong>
            <small>Product help in seconds</small>
          </span>
        </button>

        <section
          class="chat-widget"
          aria-label="Shopping assistant"
          aria-hidden="true"
          data-chat-widget-target="panel"
        >
          <header class="chat-widget-header">
            <div>
              <p class="chat-widget-kicker">Support Assistant</p>
              <h2>Smart shopping help</h2>
              <span>Usually replies in a few seconds</span>
            </div>

            <button
              type="button"
              class="chat-widget-close"
              aria-label="Close chatbot"
              data-action="chat-widget#close"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4Z"/>
              </svg>
            </button>
          </header>

          <div class="chat-widget-body">
            <div class="chat-widget-messages" data-chat-widget-target="messages">
              <div class="chat-message chat-message-assistant">
                <div class="chat-avatar">AI</div>
                <div class="chat-bubble">
                  <p>Hello. Ask about products, prices, recommendations, or comparisons.</p>
                </div>
              </div>
            </div>
          </div>

          <form class="chat-widget-form" data-action="submit->chat-widget#submit">
            <label class="sr-only" for="chat-query">Ask a question</label>
            <textarea
              id="chat-query"
              class="chat-widget-input"
              rows="1"
              placeholder="Ask about products, features, pricing, or best options..."
              data-action="input->chat-widget#resizeInput keydown->chat-widget#handleKeydown"
              data-chat-widget-target="input"
            ></textarea>
            <button type="submit" class="chat-widget-send" data-chat-widget-target="submit">
              Send
            </button>
          </form>
        </section>
      </div>
    <% else %>
      <%= render "shared/flash" %>
      <%= yield %>
    <% end %>
  </body>
</html>
