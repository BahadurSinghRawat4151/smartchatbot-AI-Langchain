<div style="max-width: 800px; margin: 0 auto; padding: 2rem;">
  <h1>Shopping Cart</h1>

  <% if @products.any? %>
    <table style="width: 100%; border-collapse: collapse; margin-top: 2rem;">
      <tr style="border-bottom: 2px solid #ddd; text-align: left;">
        <th style="padding: 10px;">Product</th>
        <th style="padding: 10px;">Price</th>
        <th style="padding: 10px;">Quantity</th>
        <th style="padding: 10px;">Subtotal</th>
        <th style="padding: 10px;"></th>
      </tr>
      <% @products.each do |product| %>
        <% quantity = @cart[product.id.to_s].to_i %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 15px 10px;"><%= product.name %></td>
          <td style="padding: 15px 10px;">₹<%= product.price %></td>
          <td style="padding: 15px 10px;"><%= quantity %></td>
          <td style="padding: 15px 10px;"><strong>₹<%= product.price * quantity %></strong></td>
          <td style="padding: 15px 10px;">
            <%= button_to "Remove", remove_item_cart_path(product_id: product.id), method: :post, style: "background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;" %>
          </td>
        </tr>
      <% end %>
    </table>

    <div style="text-align: right; margin-top: 2rem;">
      <h2>Total: ₹<%= @total %></h2>
      <%= button_to "Checkout", checkout_path, method: :post, data: { turbo: false }, style: "padding: 15px 30px; font-size: 1.2rem; background: #6772E5; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;" %>
    </div>
  <% else %>
    <div style="text-align: center; padding: 4rem; background: #f8f9fa; border-radius: 8px; margin-top: 2rem;">
      <h3>Your cart is empty.</h3>
      <%= link_to "Continue Shopping", products_path, style: "display: inline-block; margin-top: 1rem; padding: 10px 20px; background: #007bff; color: white; text-decoration: none; border-radius: 5px;" %>
    </div>
  <% end %>

  <div style="margin-top: 3rem;">
    <%= link_to "← Continue Shopping", products_path %>
  </div>
</div>
